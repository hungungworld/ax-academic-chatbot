# 이 파일을 .env 로 복사한 뒤 값을 채워 사용합니다. (.env 는 저장소에 올리지 않습니다)
# Vercel 에서는 Project Settings > Environment Variables 에 같은 이름으로 넣습니다.

# Google Gemini API 키 (무료) — Google AI Studio 에서 발급
GOOGLE_API_KEY=

# 답변에 쓸 Gemini 모델 이름 (Google AI Studio 에서 무료로 쓸 수 있는 모델명을 확인해 입력)
GEMINI_MODEL=

# 기본 모델이 바쁠 때(503 high demand) 대신 쓸 예비 모델 (선택, 쉼표로 여러 개 가능)
# 예: gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=

# 규정 검색용 Gemini 임베딩 모델 이름 (위와 같은 방식으로 확인해 입력)
# 바꾸면 npm run index 로 data/rules-index.json 을 다시 만들어야 합니다.
GEMINI_EMBEDDING_MODEL=

# Neon(Postgres) 연결 문자열 — 담당자 접수 저장
DATABASE_URL=

# 담당자 알림 메일을 보낼 Gmail 주소
GMAIL_USER=

# 위 Gmail 계정의 앱 비밀번호 (16자리, 일반 로그인 비밀번호가 아님)
# Google 계정 > 보안 > 2단계 인증을 켠 뒤 "앱 비밀번호"에서 발급
GMAIL_APP_PASSWORD=

# 알림을 받을 담당자 이메일 (여러 명이면 쉼표로 구분)
NOTIFY_TO=

# 담당자 접수 목록 페이지(/admin) 비밀번호
ADMIN_PASSWORD=

# 담당자 로그인 쿠키 서명용 임의 문자열 (32자 이상 권장)
SESSION_SECRET=
